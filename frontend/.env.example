# Local development (talks to backend/src/server.js directly):
VITE_API_URL=http://localhost:5000/api

# Production (Netlify): leave VITE_API_URL unset, or set it to /api.
# The frontend defaults to "/api" automatically, which is routed to the
# Netlify Function by the /api/* redirect in netlify.toml (same origin,
# no CORS needed).
