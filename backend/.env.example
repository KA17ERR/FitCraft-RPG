# Local development values. For Netlify, set the equivalents (JWT_SECRET,
# JWT_EXPIRES_IN, CORS_ORIGIN) as Site environment variables in the Netlify
# dashboard instead — never commit real secrets, and never hardcode them
# in netlify.toml or source.
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Netlify Blobs (production persistence) needs no manual configuration —
# NETLIFY_BLOBS_CONTEXT is injected automatically by Netlify at runtime
# for deployed Functions and for `netlify dev`.
